{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (macOS/Linux)",
      "description": "Debug build with AddressSanitizer, UndefinedBehaviorSanitizer and debug symbols",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-fsanitize=address,undefined -fno-omit-frame-pointer -g3",
        "CMAKE_C_FLAGS_DEBUG": "-fsanitize=address,undefined -fno-omit-frame-pointer -g3",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-fsanitize=address,undefined",
        "FTXUI_ENABLE_INSTALL": "OFF",
        "FTXUI_QUIET": "ON",
        "CPR_USE_SYSTEM_CURL": "ON",
        "SPDLOG_USE_STD_FORMAT": "ON"
      },
      "environment": {
        "ASAN_OPTIONS": "abort_on_error=1:print_stacktrace=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:abort_on_error=1"
      },
      "generator": "Unix Makefiles"
    },
    {
      "name": "profile",
      "displayName": "Profiling (macOS/Linux)",
      "description": "Release optimisation with debug symbols and frame pointers, for profilers",
      "binaryDir": "${sourceDir}/build/profile",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O3 -funroll-loops -fstrict-aliasing -DNDEBUG -g3 -fno-omit-frame-pointer",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O3 -DNDEBUG -g3 -fno-omit-frame-pointer",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "FTXUI_ENABLE_INSTALL": "OFF",
        "FTXUI_QUIET": "ON",
        "CPR_USE_SYSTEM_CURL": "ON",
        "SPDLOG_USE_STD_FORMAT": "ON"
      },
      "generator": "Unix Makefiles"
    },
    {
      "name": "release",
      "displayName": "Release (macOS/Linux)",
      "description": "Release build with -O3 optimization",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -funroll-loops -fstrict-aliasing -DNDEBUG",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "FTXUI_ENABLE_INSTALL": "OFF",
        "FTXUI_QUIET": "ON",
        "CPR_USE_SYSTEM_CURL": "ON",
        "SPDLOG_USE_STD_FORMAT": "ON"
      },
      "generator": "Unix Makefiles"
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer (macOS/Linux)",
      "description": "Optimised debug build with ThreadSanitizer, to find data races between the UI and background threads",
      "binaryDir": "${sourceDir}/build/tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-fsanitize=thread -O1 -g -fno-omit-frame-pointer",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-fsanitize=thread -O1 -g -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS_RELWITHDEBINFO": "-fsanitize=thread",
        "FTXUI_ENABLE_INSTALL": "OFF",
        "FTXUI_QUIET": "ON",
        "CPR_USE_SYSTEM_CURL": "ON",
        "SPDLOG_USE_STD_FORMAT": "ON"
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1"
      },
      "generator": "Unix Makefiles"
    },
    {
      "name": "vcpkg-msvc-debug",
      "displayName": "VCPKG MSVC Debug",
      "description": "Windows debug build with MSVC, debug symbols, and sanitizers",
      "binaryDir": "${sourceDir}/build/vcpkg-msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "/DEBUG /Zi /RTC1 /W3 /fsanitize=address",
        "CMAKE_EXE_LINKER_FLAGS_DEBUG": "/DEBUG",
        "FTXUI_ENABLE_INSTALL": "OFF",
        "FTXUI_QUIET": "ON",
        "CPR_USE_SYSTEM_CURL": "ON",
        "SPDLOG_USE_STD_FORMAT": "ON"
      },
      "generator": "Ninja",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    },
    {
      "name": "vcpkg-msvc-release",
      "displayName": "VCPKG MSVC Release",
      "description": "Windows release build with MSVC and maximum optimization",
      "binaryDir": "${sourceDir}/build/vcpkg-msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "/Ob2 /Ox /GL /Gy /Gw /W3",
        "CMAKE_EXE_LINKER_FLAGS_RELEASE": "/LTCG /OPT:REF /OPT:ICF",
        "FTXUI_ENABLE_INSTALL": "OFF",
        "FTXUI_QUIET": "ON",
        "CPR_USE_SYSTEM_CURL": "ON",
        "SPDLOG_USE_STD_FORMAT": "ON"
      },
      "generator": "Ninja",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "profile",
      "configurePreset": "profile",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "vcpkg-msvc-debug",
      "configurePreset": "vcpkg-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "vcpkg-msvc-release",
      "configurePreset": "vcpkg-msvc-release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "profile",
      "configurePreset": "profile",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "vcpkg-msvc-debug",
      "configurePreset": "vcpkg-msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "vcpkg-msvc-release",
      "configurePreset": "vcpkg-msvc-release",
      "configuration": "Release"
    }
  ]
}
